DATABASE_URL=postgresql://postgres:password@localhost:5432/startup_coach
SECRET_KEY=your-secret-key-change-in-production
OPENAI_API_KEY=your-openai-api-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=60

# 창업 정보 허브 수집 (hub_items)
HUB_COLLECTOR_KEY=change-me-admin-trigger-key
# data.go.kr에서 "창업진흥원_K-Startup 공고정보"(제공기관 코드 B552735) 검색 후 활용신청
KSTARTUP_API_KEY=your-data-go-kr-kstartup-service-key
# 기업마당·KOCCA는 공식 오픈API가 없어 공개 목록 페이지를 크롤링한다 — 키 불필요

